PubMedID = {40141942},
ISSN = {2072-666X},
preview = {spectral_vs_micro_2025.png},
ABSTRACT = {Fiber Bragg gratings are key components for optical fiber sensing applications in harsh environments. Microvoids, or so-called type III fiber Bragg gratings, fabricated using femtosecond lasers and the point-by-point technique, were characterized at high temperatures (>1100 °C). For this purpose, we monitored the spectral characteristics of the grating, as well as the evolution of the microstructure during a 30 min isochronal annealing process. This study allowed us to correlate the behavior of the microvoids with the spectral performances (amplitude, wavelength drift) of the sensors at very high temperatures. As the grating signal is being lost at increasing temperatures (above 1125 °C), the periodic array of microvoids becomes disordered and deformed, ultimately losing its periodic spacing.},
DOI = {10.3390/mi16030331}
}
