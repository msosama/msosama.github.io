AUTHOR = {Sosa, Matilde and Cavillon, Maxime and Blanchet, Thomas and Lancry, Matthieu and Laffont, Guillaume},
TITLE = {Spectral and Microscopic Behavior of Type III Femtosecond Fiber Bragg Gratings at High Temperatures},
JOURNAL = {Micromachines},
VOLUME = {16},
